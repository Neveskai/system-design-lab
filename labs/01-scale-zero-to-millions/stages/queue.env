# Stage 6: async work via queue + workers (book fig 1-17).
# Heavy render (RENDER_ITER/JOB_ITER = 2000, ~10x E5) stands in for export/PDF/diff.
# OP=render runs it inline in the API; OP=enqueue hands it to WORKERS workers.
API_REPLICAS=4
CACHE_MODE=aside
PG_POOL_MAX=10
TARGET=http://nginx
RENDER_ITER=2000
JOB_ITER=2000
WORKERS=2
QUEUE_MAX=0
