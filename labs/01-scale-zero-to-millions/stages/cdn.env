# Stage 5: object storage (SeaweedFS, S3 API) + edge cache in front (book fig 1-10).
# ATTACH_MODE picks how GET /attachments/:key is served when TARGET=http://nginx:
#   proxy    API streams bytes from S3 (API in the data path)
#   redirect API answers 302 to a presigned S3 URL (API out of the data path)
# TARGET=http://cdn serves /attachments straight from the edge cache.
API_REPLICAS=4
CACHE_MODE=aside
PG_POOL_MAX=10
TARGET=http://cdn
ATTACH_MODE=proxy
RENDER_MAX_AGE=10
